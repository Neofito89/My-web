<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{ title }} · Sergio Alegre Photography</title>
    <meta name="description" content="{{ description or 'Sergio Alegre — portrait and music photography based in Berlin.' }}" />
    <link rel="stylesheet" href="/css/styles.css?v={{ buildTime }}" />
    <!-- photoswipe.css se inyecta por JS (ver src/js/gallery.js): solo hace
         falta para el lightbox, no para pintar el grid, así que cargarlo
         aquí de forma síncrona bloqueaba el render sin necesidad. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/images/site.webmanifest" />
    <link rel="preload" href="/css/fonts/PoiretOne/PoiretOne-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <!-- Fuente del cuerpo del texto (styles.css: --font-body-weight: 300).
         Sin este preload, el navegador no la descubre hasta parsear
         styles.css, lo que la mete de lleno en la cadena crítica (ver
         PageSpeed: "Network dependency tree" / "Avoid chaining critical
         requests" — era el eslabón más lento de la cadena). -->
    <link rel="preload" href="/css/fonts/JosefinSans/JosefinSans-Light.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Matomo -->
<script>
  var _paq = window._paq = window._paq || [];
  /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
  _paq.push(["disableCampaignParameters"]);
  _paq.push(["setDoNotTrack", true]);
  _paq.push(["disableCookies"]);
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  _paq.push(['disableBrowserFeatureDetection']);
  (function() {
    var u="//analytics.sergioalegre.com/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '1']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
  })();
</script>

<!-- End Matomo Code -->

  </head>

  <body>

    {% include "header.njk" %}

    <main>
      <div class="gallery-wide">
    {{ content | safe }}
  </div>
    </main>

    {% include "footer.njk" %}

    <script type="module" src="/js/gallery.js?v={{ buildTime }}" defer></script>
  </body>
</html>
